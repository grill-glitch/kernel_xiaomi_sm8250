# Platform
CONFIG_MACH_XIAOMI_ALIOTH=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_SUPPORT_NEW_GAME_MODE=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC=y
CONFIG_FINGERPRINT_GOODIX=y

# Power
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_ONEWIRE_GPIO=y

# Ultrasound Proximity
CONFIG_US_PROXIMITY=y

# Vibrator
CONFIG_INPUT_AW8697_HAPTIC=y

# Camera
CONFIG_TECHPACK_CAMERA_XIAOMI=y

# KernelSU Next (non-GKI, 4.19) -- manual hook mode + SUSFS
# Integration: kernel/xiaomi/sm8250/drivers/kernelsu -> ../KernelSU-Next/kernel
# (branch "legacy" @ 8af3d4fec3, added by KernelSU-Next/kernel/setup.sh)
# SUSFS source: gitlab.com/simonpunk/susfs4ksu branch kernel-4.19 (HEAD 001e6991)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_SYSCALL_TABLE_HOOK is not set
CONFIG_KSU_SUSFS=y

# USB Serial adapters (Stage 1 low-risk port).
# All eight drivers are present in 4.19 mainline already (drivers/usb/serial/);
# CONFIG_USB_SERIAL_CP210X was already =y. The other commonly-encountered
# adapters are added here, matching what liyafe1997/.../alioth.config once
# enabled and later reverted (defconfig toggle, no source changes).
#
# No runtime regression risk on a phone: these only bind when a matching
# USB device is plugged in (CH340/CH341, FTDI, PL2303 clones, OTI-6858,
# TI 3410/5052, SPCP8x5 Z-Wave sticks, NEC uPD78F0730).
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_OTI6858=y
CONFIG_USB_SERIAL_TI=y
CONFIG_USB_SERIAL_SPCP8X5=y
CONFIG_USB_SERIAL_UPD78F0730=y
# CONFIG_USB_SERIAL_QT2 is not set   # driver source absent in 4.19 mainline

# CAN USB adapters (SocketCAN over USB).
# All seven drivers are present in 4.19 mainline already
# (drivers/net/can/usb/); CAN core / RAW / BCM / GW / DEV are already =y.
# Only the USB-side glue is missing. Use =y to match the rest of the
# alioth CAN stack — Android ramdisk does not usually carry CAN modules.
#
# gs_usb     -> CANable / candleLight / Geschwister Schneider (most common DIY)
# peak_usb   -> PEAK-System PCAN-USB / PCAN-USB Pro / PCAN-USB FD
# kvaser_usb -> Kvaser Leaf Light / USBcan II / Memorator Pro 5xHS
# mcba_usb   -> Microchip CAN BUS Analyzer
# ucan       -> Theobroma Systems UCAN
# 8dev_usb   -> 8devices USB2CAN
# esd_usb2 / ems_usb also available, not enabled to keep init ramdisk lean
CONFIG_CAN_GS_USB=y
# CONFIG_CAN_PEAK_USB is not set   # pcan_usb_pro.c:136 trips -Wvarargs
                                   # on 4.19 + clang r563880c -Werror;
                                   # driver source itself is buggy upstream,
                                   # no defconfig-only fix. Leave for stage 2.
CONFIG_CAN_KVASER_USB=y
CONFIG_CAN_MCBA_USB=y
CONFIG_CAN_UCAN=y
CONFIG_CAN_8DEV_USB=y

# ZRAM high-compression LZ4HC backend.
# CRYPTO_LZO / CRYPTO_LZ4 / CRYPTO_ZSTD are already =y via parent fragments,
# but CRYPTO_LZ4HC is missing — so drivers/block/zram/zcomp.c does NOT
# register the "lz4hc" string and `cat /sys/block/zram0/comp_algorithm`
# does not list lz4hc. Adding CONFIG_CRYPTO_LZ4HC=y makes lz4hc selectable
# alongside lzo / lz4 / zstd at runtime via:
#   zram0 /sys/block/zram0/comp_algorithm   -> shows lzo lz4 lz4hc zstd
#   echo lz4hc > /sys/block/zram0/comp_algorithm
#
# Note: 842 / LZ4K / LZ4KD / LZO-RLE are intentionally NOT enabled here —
# they belong to a later stage (require broader zram / lib backports).
CONFIG_CRYPTO_LZ4HC=y

# NetHunter: USB RNDIS Ethernet gadget (Windows tethering).
# Present in 4.19 mainline drivers/usb/gadget/Kconfig (line ~356) but not
# enabled by kona-perf_defconfig. RNDIS is the primary USB-Ethernet protocol
# Windows PCs recognize out of the box; once CONFIGFS exposes it, Android
# userspace can bind it via
#   /config/usb_gadget/g1/functions/rndis.usb0
# No source change.
CONFIG_USB_CONFIGFS_RNDIS=y

# NetHunter: USB CDC ECM Ethernet gadget (Mac / Linux tethering).
# Present in 4.19 mainline drivers/usb/gadget/Kconfig (line ~324) but not
# enabled by kona-perf_defconfig. CDC ECM is the standard USB-Ethernet
# protocol native to Linux and macOS — paired with RNDIS this gives
# NetHunter USB tethering to any PC OS.
# No source change.
CONFIG_USB_CONFIGFS_ECM=y

# NetHunter: USB CDC ACM (serial gadget over USB).
# Present in 4.19 mainline drivers/usb/gadget/Kconfig (line ~292) but not
# enabled by kona-perf_defconfig. CDC ACM exposes a USB serial port
# (/dev/ttyGS*) over the USB cable — used by NetHunter tooling that
# communicates over a virtual serial line (BadUSB HID injection chains,
# serial-based attack tools, console-over-USB for chrooted sessions).
# No source change.
CONFIG_USB_CONFIGFS_ACM=y

# NetHunter: Bluetooth protocol stack extensions for HID + PAN attacks.
# All four symbols are present in 4.19 mainline (net/bluetooth/rfcomm,
# net/bluetooth/bnep, net/bluetooth/hidp, drivers/bluetooth Kconfigs) but
# none are enabled by kona-perf_defconfig — only the BT core (=y) is on.
#
# BT_RFCOMM   - RFCOMM channel for serial-profile attacks (Bluetooth serial)
# BT_BNEP     - BNEP for Bluetooth PAN tethering / NAP / GN
# BT_HIDP     - Bluetooth HID profile (used by HID attack tools)
# BT_HCIBTUSB - USB Bluetooth HCI transport (external USB BT adapters)
#
# Together these let NetHunter pair with a remote BT device, present as a
# BT keyboard/mouse (HIDP), or expose BNEP for PAN attacks. Adding them
# is orthogonal to the existing BT core (CONFIG_BT=y already set).
#
# No source change. Defconfig-only toggle.
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y

# NetHunter: TC actions for MITM traffic rewriting.
# NET_ACT_CSUM   - update TCP/UDP checksum in skb after edit (required after pedit)
# NET_ACT_NAT    - NAT (replace src/dst IP:port) inside tc filter
# NET_ACT_PEDIT  - arbitrary byte-level packet editor (offset + value)
# All three are present in 4.19 mainline net/sched/Kconfig but not enabled
# by kona-perf_defconfig. They are the core of NetHunter on-device MITM
# tooling (sslstrip, netsed, tcprewrite, responder hooks, evilginx-style
# payload rewriting).
#
# Kconfig: net/sched/Kconfig (4.19 mainline, dependencies auto-resolved:
#   NET_ACT_CSUM depends on NET_CLS_ACT=y && INET=y — both =y in this tree
#   NET_ACT_NAT  depends on NET_CLS_ACT=y && INET=y && NF_NAT=y
#   NET_ACT_PEDIT depends on NET_CLS_ACT=y && INET=y
# No source change. Defconfig-only.
CONFIG_NET_ACT_CSUM=y
CONFIG_NET_ACT_NAT=y
CONFIG_NET_ACT_PEDIT=y

# NetHunter: USB 1.1 / 2.0 host controller fallback.
# Modern phones (including alioth) typically use only XHCI (USB 3.x). When
# alioth is put into USB-host mode (via OTG cable + USB hub), devices
# advertising only USB 1.1 / USB 2.0 full-speed endpoints still work via
# XHCI backward compatibility — but some older USB devices with quirky
# implementations expose themselves better when EHCI/OHCI HCDs are also
# available. NetHunter's "USB host" mode targets real-world deployments
# where the analyst plugs in legacy sniffers, key loggers, and rubber-ducky
# clones that predate USB 3.x.
#
# USB_EHCI_HCD       - USB 2.0 host controller (EHCI spec, xHCI fallback
#                       when xHCI driver quirks-out a USB 2.0 port)
# USB_EHCI_HCD_PLATFORM - generic-platform EHCI (QCOM SoC glue; alioth does
#                       not use this but enabling does no harm)
# USB_OHCI_HCD       - USB 1.1 host controller (companion controller to
#                       EHCI on classic x86 systems; on arm64 with xHCI-only
#                       SoCs, it is dead code but compile-only)
# USB_OHCI_HCD_PLATFORM - same for OHCI
#
# All Kconfig in 4.19 mainline drivers/usb/host/Kconfig.
# No source change. Defconfig-only.
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
